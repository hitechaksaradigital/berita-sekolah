# Salin file ini menjadi .env lalu isi dengan kredensial proyek Supabase Anda.
# Keduanya boleh dilihat publik (ANON_KEY aman selama RLS aktif di Supabase).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Nama aplikasi (opsional, dipakai di judul tab)
VITE_SITE_NAME=Berita Sekolah
